+ */
+package org.videolan.vlc.util
+
+/**
+ * Reads the show name, season and episode from a file name such as
+ * "Show Name S03E02 Episode Title (1080p).mkv" or "Show.Name.S03E02.1080p.mkv".
+ * Also reads "Show 3x02". The name may be a full path: only the last part is used.
+ * Returns null when the name has no season and episode part (a film, for example).
+ */
+data class EpisodeGuess(val show: String, val season: Int, val episode: Int) {
+    companion object {
+        private val SEASON_EPISODE = Regex("""^(.*?)[\s._-]+[sS](\d{1,2})[\s._-]*[eE](\d{1,3})(?!\d)""")
+        private val CROSS = Regex("""^(.*?)[\s._-]+(\d{1,2})[xX](\d{2,3})(?!\d)""")
+        private val TRAILING_YEAR = Regex("""\s*[(\[]?\s*(?:19|20)\d{2}\s*[)\]]?\s*$""")
+        private val SPACES = Regex("""\s+""")
+
+        fun from(name: String?): EpisodeGuess? {
+            if (name.isNullOrBlank()) return null
+            // A server on Windows sends a path with backslashes. Keep the last part only.
+            val base = name.substringAfterLast('\\').substringAfterLast('/')
+            val match = SEASON_EPISODE.find(base) ?: CROSS.find(base) ?: return null
+            val show = match.groupValues[1].replace('.', ' ').replace('_', ' ')
+                .replace(TRAILING_YEAR, "")
+                .replace(SPACES, " ")
+                .trim(' ', '-', '(', '[')
+                .trim()
+            if (show.isEmpty()) return null
+            return EpisodeGuess(show, match.groupValues[2].toInt(), match.groupValues[3].toInt())
+        }
+    }
+}
